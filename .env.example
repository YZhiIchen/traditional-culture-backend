# 传统文化数字化平台 — 环境变量示例
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env

# ────────────────────────────────────────
# JWT 签名密钥（生产环境务必修改为随机长字符串）
# ────────────────────────────────────────
SECRET_KEY=your-secret-key-at-least-16-chars

# ────────────────────────────────────────
# 数据库连接（默认使用 SQLite）
# 切换 MySQL 示例：mysql+pymysql://user:pass@localhost:3306/dbname
# ────────────────────────────────────────
DATABASE_URL=sqlite:///./data.db

# ────────────────────────────────────────
# 服务监听地址与端口
# ────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ────────────────────────────────────────
# 🔒 CORS 安全配置
# 生产环境请设置为前端域名，多个用逗号分隔
# 保持 * 可允许所有来源（仅开发环境）
# ────────────────────────────────────────
# CORS_ORIGINS=https://example.com,https://admin.example.com
CORS_ORIGINS=*

# ────────────────────────────────────────
# 🔒 JWT 配置
# ACCESS_TOKEN_EXPIRE_MINUTES: access_token 有效期（分钟，默认 60）
# ────────────────────────────────────────
# JWT_EXPIRE_MINUTES=60

# ────────────────────────────────────────
# 🔒 速率限制配置
# 格式：次数/时间窗口 (s=秒, m=分, h=时, d=天)
# ────────────────────────────────────────
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_REGISTER=3/minute
# RATE_LIMIT_DEFAULT=60/minute

# ────────────────────────────────────────
# 阿里通义千问（DashScope）API 密钥
# 用于图像识别（qwen-vl-plus）与文本分析（qwen-plus）
# 获取地址：https://dashscope.console.aliyun.com/
# ────────────────────────────────────────
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here