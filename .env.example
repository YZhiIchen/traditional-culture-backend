# 传统文化数字化平台 — 环境变量示例
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env

# ────────────────────────────────────────
# JWT 签名密钥（生产环境务必修改为随机长字符串）
# ────────────────────────────────────────
SECRET_KEY=traditional-culture-secret-change-in-production

# ────────────────────────────────────────
# 数据库连接（默认使用 SQLite）
# 切换 MySQL 示例：mysql+pymysql://user:pass@localhost:3306/dbname
# ────────────────────────────────────────
DATABASE_URL=sqlite:///./data.db

# ────────────────────────────────────────
# 服务监听地址与端口
# ────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ────────────────────────────────────────
# 阿里通义千问（DashScope）API 密钥
# 用于图像识别（qwen-vl-plus）与文本分析（qwen-plus）
# 获取地址：https://dashscope.console.aliyun.com/
# ────────────────────────────────────────
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here